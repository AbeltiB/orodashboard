DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Pre-seeded super admin — created idempotently at server boot if no admin
# with this phone number exists yet. Safe to change later via the dashboard;
# these env vars only matter for the very first boot.
SUPER_ADMIN_PHONE="+251900000000"
SUPER_ADMIN_FIRST_NAME="First"
SUPER_ADMIN_MIDDLE_NAME="Middle"
SUPER_ADMIN_LAST_NAME="Last"

# OTA (company.ota.gov.et) sales-report source system — credentials for the
# read-only company-user login used to pull the trips report.
OTA_BASE_URL="https://company.ota.gov.et"
OTA_EMAIL="user@example.com"
OTA_PASSWORD="changeme"
OTA_COMPANY_ID="00000000-0000-0000-0000-000000000000"

# Shared secret an external cron trigger presents to POST /api/sales/sync
# instead of an admin session.
SALES_SYNC_TOKEN="change-me-to-a-long-random-value"

# AfroMessage — sends OTP codes and other SMS (see src/lib/sms.ts). Get these
# from your AfroMessage dashboard (afromessage.com).
OTP_URL="https://api.afromessage.com/api/send"
OTP_FROM="00000000-0000-0000-0000-000000000000"
OTP_SENDER="Your Sender Name"
OTP_TOKEN="change-me-to-your-afromessage-api-token"

# verify.et — verifies a cashier's bank/mobile-money deposit reference number
# (amount, sender, timestamp) before a Deposit is marked settled. Get the key
# from your verify.et dashboard (Settings -> API Keys) with
# verification:read + verification:write permissions.
VERIFY_ET_API_KEY="VERIFY_BANK_ET_your_key_here"
# Optional override — defaults to https://verify.et if unset.
VERIFY_ET_BASE_URL="https://verify.et"

# Shared secret an external cron trigger presents to POST /api/deposits/poll-pending
# instead of an admin session — sweeps any deposit still stuck in SUBMITTED
# (verify.et hadn't completed synchronously when the cashier submitted it).
DEPOSIT_POLL_TOKEN="change-me-to-a-long-random-value"

# Telegram bot for daily/custom reports (src/lib/telegram/*). Create a bot via
# @BotFather in Telegram ("/newbot") to get this token.
TELEGRAM_BOT_TOKEN="123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Shared secret an external cron presents to POST /api/telegram/run-scheduled
# (fires any due scheduled report) and POST /api/telegram/poll-updates (links
# any recipient who has messaged the bot since the last check) instead of an
# admin session. Call both every 1-5 minutes; both are safe at any cadence.
TELEGRAM_CRON_TOKEN="change-me-to-a-long-random-value"
