// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Region {
  ADDIS_ABABA
  OROMIA
  AMHARA
  TIGRAY
  SNNPR
  AFAR
  SOMALI
  BENISHANGUL_GUMUZ
  GAMBELA
  HARARI
  DIRE_DAWA
  SIDAMA
}

enum RoadType {
  ASPHALT
  GRAVEL
  MIXED
}

enum EmployeeRole {
  SUPERVISOR
  TICKETER
  CASHIER
}

enum Sex {
  MALE
  FEMALE
}

enum PosStatus {
  ACTIVE
  IDLE
  MAINTENANCE
  DECOMMISSIONED
}

enum DeliveryMethod {
  BANK_TRANSFER
  CHEQUE
  TELEBIRR
  OTHER
}

enum BusType {
  BUS
  MIDBUS
  MINIBUS
}

enum BusLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

enum PosAssignmentMode {
  EXCLUSIVE // one employee has custody of the machine (default, existing behavior)
  SHARED    // station-level hardware, rotates between employees by shift — see PosSession
}

enum ShiftType {
  MORNING
  AFTERNOON
}

// ─────────────────────────────────────────────────────────────────────────────
// STATION
// ─────────────────────────────────────────────────────────────────────────────

model Station {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. "STN-001" — human-readable code
  name      String
  region    Region
  location  String   // street / landmark description

  zoneId    String?
  zone      Zone?    @relation(fields: [zoneId], references: [id])

  // Soft delete
  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  terminalsAsOrigin  Terminal[] @relation("OriginStation")
  terminalsAsTarget  Terminal[] @relation("TargetStation")
  employees          Employee[]
  posMachines        PosMachine[]
  posMachineHistory  PosMachineHistory[]
  posSessions        PosSession[]
  shiftAssignments   ShiftAssignment[]
  cashierAssignments CashierStationAssignment[]
  telegramRecipients TelegramRecipient[]

  @@index([isDeleted])
  @@index([region])
  @@index([zoneId])
  @@map("stations")
}

// ─────────────────────────────────────────────────────────────────────────────
// ZONE  (groups stations within a region; has its own supervisor(s))
// ─────────────────────────────────────────────────────────────────────────────

model Zone {
  id          String    @id @default(cuid())
  region      Region
  name        String
  description String?

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stations    Station[]
  supervisors ZoneSupervisor[]

  @@unique([region, name])
  @@index([isDeleted])
  @@map("zones")
}

model ZoneSupervisor {
  id         String   @id @default(cuid())

  zoneId     String
  zone       Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  assignedAt DateTime @default(now())

  @@unique([zoneId, employeeId])
  @@index([employeeId])
  @@map("zone_supervisors")
}

// ─────────────────────────────────────────────────────────────────────────────
// TERMINAL
// ─────────────────────────────────────────────────────────────────────────────

model Terminal {
  id               String   @id @default(cuid())

  stationId        String
  station          Station  @relation("OriginStation", fields: [stationId], references: [id])

  name             String

  isLinkedStation  Boolean  @default(false)
  linkedStationId  String?
  linkedStation    Station? @relation("TargetStation", fields: [linkedStationId], references: [id])

  isDeparture      Boolean  @default(false)
  isArrival        Boolean  @default(true)

  distanceKm       Decimal  @db.Decimal(8, 2)
  roadType         RoadType

  asphaltKm        Decimal? @db.Decimal(8, 2)
  gravelKm         Decimal? @db.Decimal(8, 2)

  isDeleted        Boolean  @default(false)
  deletedAt        DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cashierAssignments CashierTerminalAssignment[]
  deposits           Deposit[]

  @@index([stationId, isDeleted])
  @@index([linkedStationId])
  @@map("terminals")
}

// ─────────────────────────────────────────────────────────────────────────────
// EMPLOYEE
// ─────────────────────────────────────────────────────────────────────────────

model Employee {
  id             String      @id @default(cuid())
  code           String      @unique // e.g. "EMP-001"

  firstName      String
  middleName     String?
  lastName       String

  phone          String      @unique
  email          String?     @unique

  posPassword    String?

  // Fayda Alias Number — 16 digits stored without dashes
  fan            String?     @unique @db.Char(16)

  stationId      String?
  station        Station?    @relation(fields: [stationId], references: [id])

  basicSalary    Decimal     @db.Decimal(10, 2)
  role           EmployeeRole
  accountNumber  String?
  employmentDate DateTime?   @db.Date
  sex            Sex

  isDeleted      Boolean     @default(false)
  deletedAt      DateTime?

  // Cashier sign-in (deposit reconciliation portal) — separate PIN from
  // OroDashboard admin accounts entirely; set/reset by an admin, never an
  // OTP-derived flow like AdminUser's. See src/lib/cashier-session.ts.
  cashierPinHash        String?
  cashierPinAttempts    Int       @default(0)
  cashierPinLockedUntil DateTime?
  cashierPinSetAt       DateTime?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  posMachines         PosMachine[]
  posMachineHistory   PosMachineHistory[]
  pettyCash           PettyCash[]
  zoneSupervisorOf    ZoneSupervisor[]
  posSessions         PosSession[]
  shiftAssignments    ShiftAssignment[]
  cashierSessions     CashierSession[]
  terminalAssignments CashierTerminalAssignment[]
  stationAssignments  CashierStationAssignment[]
  deposits            Deposit[]

  @@index([stationId, isDeleted])
  @@index([role])
  @@index([isDeleted])
  @@map("employees")
}

// ─────────────────────────────────────────────────────────────────────────────
// PETTY CASH
// ─────────────────────────────────────────────────────────────────────────────

model PettyCash {
  id          String         @id @default(cuid())

  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id])

  amount      Decimal        @db.Decimal(10, 2)
  date        DateTime       @db.Date
  method      DeliveryMethod
  reference   String
  note        String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([employeeId])
  @@index([date])
  @@map("petty_cash")
}

// ─────────────────────────────────────────────────────────────────────────────
// POS MACHINE
// ─────────────────────────────────────────────────────────────────────────────

model PosMachine {
  id                 String    @id @default(cuid())
  code               String    @unique // e.g. "POS-001"

  make               String
  model              String
  serial             String    @unique
  status             PosStatus @default(ACTIVE)
  appVersion         String
  remark             String?

  // EXCLUSIVE: employeeId below is the current owner (existing behavior).
  // SHARED: employeeId stays null — "who's on it now" is derived from the
  // PosSession with endedAt = null for this machine instead.
  assignmentMode     PosAssignmentMode @default(EXCLUSIVE)

  stationId          String?
  station            Station?  @relation(fields: [stationId], references: [id])

  employeeId         String?
  employee           Employee? @relation(fields: [employeeId], references: [id])

  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  history            PosMachineHistory[]
  sessions           PosSession[]
  shiftAssignments   ShiftAssignment[]

  @@index([stationId])
  @@index([employeeId])
  @@index([status, isDeleted])
  @@map("pos_machines")
}

// ─────────────────────────────────────────────────────────────────────────────
// POS SESSION  (manual usage log for SHARED-mode machines — see note on
// PosMachine.assignmentMode. There is no integration with the actual POS
// ticketing app; this is maintained inside OroDashboard only.)
// ─────────────────────────────────────────────────────────────────────────────

model PosSession {
  id           String     @id @default(cuid())

  posMachineId String
  posMachine   PosMachine @relation(fields: [posMachineId], references: [id])

  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  employeeName String     // snapshot at session start — same precedent as PosMachineHistory

  stationId    String?
  station      Station?   @relation(fields: [stationId], references: [id])
  stationName  String?

  startedAt    DateTime   @default(now())
  endedAt      DateTime?  // null = currently active (at most one open session per machine, enforced transactionally)

  note         String?
  loggedBy     String?    // AdminUser id — accountability for a manually-entered log

  // Optional link to the scheduled shift this session was worked under. Not
  // unique — a shift could plausibly span more than one session.
  shiftAssignmentId String?
  shiftAssignment   ShiftAssignment? @relation(fields: [shiftAssignmentId], references: [id])

  @@index([posMachineId, endedAt])
  @@index([employeeId])
  @@index([stationId])
  @@index([shiftAssignmentId])
  @@map("pos_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// POS MACHINE HISTORY
// ─────────────────────────────────────────────────────────────────────────────

model PosMachineHistory {
  id           String     @id @default(cuid())

  posMachineId String
  posMachine   PosMachine @relation(fields: [posMachineId], references: [id])

  employeeId   String?
  employee     Employee?  @relation(fields: [employeeId], references: [id])
  employeeName String?

  stationId    String?
  station      Station?   @relation(fields: [stationId], references: [id])
  stationName  String?

  fromDate     DateTime   @db.Date
  toDate       DateTime?  @db.Date

  remark       String?

  createdAt    DateTime   @default(now())

  @@index([posMachineId])
  @@index([employeeId])
  @@index([toDate])
  @@map("pos_machine_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// SHIFT SCHEDULE  (weekly schedule is generated by an external scheduler
// system; OroDashboard doesn't generate it — it imports and displays it)
// ─────────────────────────────────────────────────────────────────────────────

model ShiftAssignment {
  id            String       @id @default(cuid())

  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id])

  stationId     String
  station       Station      @relation(fields: [stationId], references: [id])

  date          DateTime     @db.Date
  shiftType     ShiftType

  // Role the employee is covering for this shift — not necessarily their
  // primary Employee.role (e.g. a supervisor filling in as a ticketer).
  role          EmployeeRole

  posMachineId  String?
  posMachine    PosMachine?  @relation(fields: [posMachineId], references: [id])

  source        String       @default("manual") // "manual" | "import"
  externalRef   String?      // scheduler's own id — traceability only, not the dedup key

  importBatchId String?
  importBatch   ShiftImportBatch? @relation(fields: [importBatchId], references: [id])

  posSessions   PosSession[]

  isDeleted     Boolean      @default(false)
  deletedAt     DateTime?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([employeeId, date, shiftType])
  @@index([stationId, date])
  @@index([date, shiftType])
  @@index([posMachineId])
  @@index([importBatchId])
  @@map("shift_assignments")
}

model ShiftImportBatch {
  id           String   @id @default(cuid())

  fileName     String
  importedBy   String   // AdminUser id

  rowCount     Int
  successCount Int
  errorCount   Int
  errors       Json?    // [{ row, message }]

  createdAt    DateTime @default(now())

  assignments  ShiftAssignment[]

  @@map("shift_import_batches")
}

// ─────────────────────────────────────────────────────────────────────────────
// FARE PRICE MATRIX
// ─────────────────────────────────────────────────────────────────────────────

model FareMatrix {
  id           String   @id @default(cuid())

  busType      BusType
  busLevel     BusLevel

  asphaltRate  Decimal  @db.Decimal(8, 4)
  gravelRate   Decimal  @db.Decimal(8, 4)

  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([busType, busLevel])
  @@index([busType])
  @@map("fare_matrix")
}

// ─────────────────────────────────────────────────────────────────────────────
// SYSTEM CONFIG  (key-value store for settings)
// ─────────────────────────────────────────────────────────────────────────────

model SystemConfig {
  key         String   @id
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@map("system_config")
}

// ─────────────────────────────────────────────────────────────────────────────
// ADMIN USER
// ─────────────────────────────────────────────────────────────────────────────

model AdminUser {
  id            String    @id @default(cuid())

  firstName     String
  middleName    String?
  lastName      String

  phone         String    @unique // +251XXXXXXXXX — login identifier
  companyEmail  String?
  personalEmail String?

  role          AdminRole @default(ADMIN)
  isActive      Boolean   @default(true)

  // Per-page permissions — [{ page, canView, canEdit }], validated at the API boundary
  permissions   Json      @default("[]")

  // OTP (hashed via bcrypt — see src/lib/pin.ts — never store the raw code)
  otpCodeHash    String?
  otpExpiresAt   DateTime?
  otpAttempts    Int       @default(0)
  otpRequestedAt DateTime? // for resend rate-limiting

  // Lockout after repeated failed OTP attempts
  lockedUntil    DateTime?

  // PIN sign-in (hashed via bcrypt — see src/lib/pin.ts, same helper the OTP
  // code itself uses) — a faster path on a device that's already proven
  // itself via OTP once. Lockout here is deliberately separate from the OTP
  // lockout above: exhausting PIN attempts should just fall back to OTP,
  // not lock the account out of signing in entirely.
  pinHash        String?
  pinAttempts    Int       @default(0)
  pinLockedUntil DateTime?
  pinSetAt       DateTime?

  lastLoginAt    DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions       Session[]
  trustedDevices TrustedDevice[]

  @@index([role])
  @@index([isActive])
  @@map("admin_users")
}

model Session {
  id          String    @id @default(cuid())

  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  tokenHash   String    @unique // sha256(rawToken) — raw token only ever lives in the cookie
  expiresAt   DateTime            // createdAt + 7 days, fixed — never slides
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())

  userAgent   String?
  ipAddress   String?

  revokedAt   DateTime? // set on logout / admin deactivation; NULL = still valid

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("sessions")
}

// A browser that's already proven itself via a full OTP sign-in once —
// lets that browser use the faster PIN sign-in next time instead of asking
// for OTP again. Deliberately separate from Session (much longer-lived, and
// "trusted" is a different concept than "currently signed in").
model TrustedDevice {
  id          String    @id @default(cuid())

  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  tokenHash   String    @unique // sha256(rawToken) — raw token only ever lives in the cookie
  expiresAt   DateTime            // createdAt + 180 days, fixed — never slides
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())

  userAgent   String?
  ipAddress   String?

  revokedAt   DateTime? // set on "forget this device" / admin deactivation; NULL = still valid

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("trusted_devices")
}

// ─────────────────────────────────────────────────────────────────────────────
// CASHIER DEPOSIT RECONCILIATION — a cashier (an Employee, existing or newly
// created) is put in charge of depositing one or more terminals' daily cash
// collections. They sign into a separate, lightweight portal (phone + PIN,
// distinct from the AdminUser/OTP world entirely) to see what they owe for
// the day and submit the bank/mobile-money reference number once they've
// deposited it. That reference is verified against verify.et (see
// src/lib/verify-et/client.ts) so the amount, sender, and timestamp are
// confirmed independently rather than just trusted from typed input.
// ─────────────────────────────────────────────────────────────────────────────

model CashierSession {
  id          String    @id @default(cuid())

  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  tokenHash   String    @unique // sha256(rawToken) — raw token only ever lives in the cookie
  expiresAt   DateTime            // createdAt + 7 days, fixed — never slides
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())

  userAgent   String?
  ipAddress   String?

  revokedAt   DateTime? // set on logout / admin unassigning this cashier; NULL = still valid

  @@index([employeeId])
  @@index([expiresAt])
  @@map("cashier_sessions")
}

// Which terminal(s) a cashier is responsible for depositing. Many-to-many so
// one employee can cover several terminals and (in principle) a terminal
// could have more than one cashier rotating through it.
model CashierTerminalAssignment {
  id          String    @id @default(cuid())

  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  terminalId  String
  terminal    Terminal  @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  isActive    Boolean   @default(true)
  assignedAt  DateTime  @default(now())
  assignedBy  String?   // AdminUser id

  @@unique([employeeId, terminalId])
  @@index([terminalId, isActive])
  @@map("cashier_terminal_assignments")
}

// Which station(s) a cashier covers for the day-to-day sales reconciliation
// portal (src/app/cashier/sales) — deliberately separate from
// CashierTerminalAssignment above (that one scopes the verify.et deposit
// flow to specific terminals). A station assignment is broader: it covers
// every route/terminal departing from that station, so a cashier doesn't
// need re-assigning every time a new route opens at their station.
model CashierStationAssignment {
  id          String    @id @default(cuid())

  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  stationId   String
  station     Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  isActive    Boolean   @default(true)
  assignedAt  DateTime  @default(now())
  assignedBy  String?   // AdminUser id

  @@unique([employeeId, stationId])
  @@index([stationId, isActive])
  @@map("cashier_station_assignments")
}

enum DepositStatus {
  AWAITING_SUBMISSION // expected amount computed, cashier hasn't submitted a reference yet
  SUBMITTED           // reference submitted; verify.et request queued/in flight
  VERIFIED_OK         // verify.et confirmed the payment and the amount matches (within tolerance)
  VERIFIED_MISMATCH   // verify.et confirmed the payment but the amount differs from what was expected
  FAILED              // verify.et couldn't confirm the payment (invalid reference, wrong bank, etc.)
  RESOLVED            // an admin has written a reason for a mismatch/failure and closed it out
}

// One row per cashier + terminal + business day. `expectedAmount` is the sum
// of that terminal's SalesTrip departures for the day (kept live/recomputed
// while still AWAITING_SUBMISSION, frozen once a verification completes) —
// see computeExpectedDeposit() in src/lib/deposits.ts.
model Deposit {
  id                    String        @id @default(cuid())

  employeeId            String
  employee              Employee      @relation(fields: [employeeId], references: [id])

  terminalId            String
  terminal              Terminal      @relation(fields: [terminalId], references: [id])

  date                  DateTime      @db.Date

  expectedAmount        Decimal       @db.Decimal(12, 2)

  // What the cashier submitted — bank is one of verify.et's supported keys
  // (cbe/boa/telebirr/mpesa/cbebirr/dashen/awash/siinqee/kaafiebirr).
  bank                  String?
  referenceNumber       String?
  accountSuffix         String?       // required by cbe/boa
  phoneNumber           String?       // required by cbebirr, optional elsewhere

  status                DepositStatus @default(AWAITING_SUBMISSION)

  // verify.et's own request id — used to poll /api/verify/:requestId when the
  // initial submit came back 202 (queued) instead of a synchronous result.
  verifyRequestId       String?       @unique
  verifiedAmount        Decimal?      @db.Decimal(12, 2)
  currency              String?
  senderName            String?
  receiverName          String?
  receiverAccount       String?
  verifiedAt            DateTime?
  verifyErrorMessage    String?
  rawVerifyResponse     Json?

  // Set once a verification lands as VERIFIED_MISMATCH — signed, so a
  // shortfall is negative and an overage is positive.
  discrepancyAmount     Decimal?      @db.Decimal(12, 2)
  discrepancyReason     String?
  discrepancyResolvedBy String?       // AdminUser id
  discrepancyResolvedAt DateTime?

  submittedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([employeeId, terminalId, date])
  @@index([terminalId, date])
  @@index([date])
  @@index([status])
  @@map("deposits")
}

// ─────────────────────────────────────────────────────────────────────────────
// TELEGRAM REPORTING — daily/custom text reports sent to admin-chosen
// recipients over Telegram. A bot can't DM an arbitrary phone number (Bot API
// limitation), so each recipient links themselves once via a one-time
// `https://t.me/<bot>?start=<linkToken>` deep link (see src/lib/telegram/*);
// after that their telegramChatId is known and reports can be pushed to them
// directly, fully controlled from the admin dashboard.
// ─────────────────────────────────────────────────────────────────────────────

enum TelegramReportType {
  DAILY_SALES_SUMMARY
  DAILY_DEPOSITS_SUMMARY
  DAILY_SERVICE_CHARGE_BREAKDOWN
  MONTHLY_SALES_SUMMARY
  CUSTOM
}

enum TelegramReportFor {
  TODAY
  YESTERDAY
}

enum TelegramMessageStatus {
  SENT
  FAILED
}

enum TelegramFrequency {
  DAILY             // every day
  EVERY_N_DAYS      // every `intervalDays` days, counted from `anchorDate`
  WEEKLY            // every week on `weekday`
  MONTHLY           // every (Gregorian) month on `dayOfMonth` (clamped to that month's length)
  QUARTERLY         // every Jan/Apr/Jul/Oct on `dayOfMonth`
  YEARLY            // every year on `monthOfYear`/`dayOfMonth`
  ETHIOPIAN_MONTHLY // every Ethiopian-calendar month, on its 1st day (a moving Gregorian date) — no extra fields needed, like DAILY
}

model TelegramRecipient {
  id                String    @id @default(cuid())

  label             String    // admin's own name for this person, e.g. "Abelti (Owner)"
  phone             String?   // optional note only — Telegram linking never uses this

  // When set, this recipient only sees their one station's slice of a
  // report instead of the full thing — a station cashier who should get
  // just "their" numbers, not everyone's. Currently only honored by
  // DAILY_SERVICE_CHARGE_BREAKDOWN (see runSchedule); every other report
  // type still sends its one shared build regardless of this. Null means
  // "sees everything," same as before this field existed.
  stationId         String?
  station           Station?  @relation(fields: [stationId], references: [id], onDelete: SetNull)

  // One-time deep-link token (?start=<linkToken>) — consumed the moment the
  // recipient's first /start message is polled (see runUpdatesPoll).
  linkToken         String    @unique
  telegramChatId    String?   @unique
  telegramUsername  String?
  telegramFirstName String?
  linkedAt          DateTime?

  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  schedules         TelegramScheduleRecipient[]
  messages          TelegramMessageLog[]

  @@index([isActive])
  @@index([stationId])
  @@map("telegram_recipients")
}

// A recurring report — "daily sales at 08:00", "daily deposits at 21:00",
// or a recurring custom message. One-off custom sends (see
// POST /api/telegram/send-custom) don't create a row here at all.
model TelegramSchedule {
  id              String              @id @default(cuid())

  name            String
  reportType      TelegramReportType
  // Which calendar day the report covers — ignored for CUSTOM. Lets the same
  // "daily sales" type be scheduled either as a morning recap of yesterday
  // or an evening recap of today.
  reportFor       TelegramReportFor   @default(YESTERDAY)
  messageTemplate String?             // required for CUSTOM; supports a {{date}} placeholder
  // DAILY_SALES_SUMMARY/DAILY_DEPOSITS_SUMMARY only — also attaches a
  // multi-sheet Excel workbook (full row-level detail + per-station/
  // ticketer/route rollups) alongside the short text recap.
  includeDetailedFile Boolean         @default(false)

  // How often this recurs — see TelegramFrequency. Each schedule has its own
  // independent cadence, so a daily, a weekly, and a monthly report can all
  // be active at once without interfering with each other.
  frequency       TelegramFrequency   @default(DAILY)
  intervalDays    Int?                // EVERY_N_DAYS: fire every N days
  anchorDate      DateTime?           @db.Date // EVERY_N_DAYS: reference day-zero for the N-day cycle
  weekday         Int?                // WEEKLY: 0 (Sunday) - 6 (Saturday)
  dayOfMonth      Int?                // MONTHLY/QUARTERLY/YEARLY: 1-31, clamped to the actual month length
  monthOfYear     Int?                // YEARLY: 1-12

  // Local time-of-day in Africa/Addis_Ababa (fixed — the business operates
  // in one timezone, EAT has no DST) that this fires on its due day.
  sendHour        Int
  sendMinute      Int

  isActive        Boolean             @default(true)
  // Dedup guard for runDueSchedules — the calendar day (Addis time) this
  // last actually fired, so a cron polling every few minutes doesn't send
  // the same day's report twice.
  lastRunDate     DateTime?           @db.Date
  lastRunStatus   String?

  createdBy       String?             // AdminUser id
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  recipients      TelegramScheduleRecipient[]
  messages        TelegramMessageLog[]

  @@index([isActive])
  @@map("telegram_schedules")
}

model TelegramScheduleRecipient {
  id          String            @id @default(cuid())

  scheduleId  String
  schedule    TelegramSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   TelegramRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, recipientId])
  @@index([recipientId])
  @@map("telegram_schedule_recipients")
}

model TelegramMessageLog {
  id           String                 @id @default(cuid())

  scheduleId   String?                // null for one-off custom sends
  schedule     TelegramSchedule?      @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  recipientId  String
  recipient    TelegramRecipient      @relation(fields: [recipientId], references: [id])

  reportType   TelegramReportType
  content      String
  status       TelegramMessageStatus
  errorMessage String?

  sentAt       DateTime               @default(now())

  @@index([recipientId])
  @@index([scheduleId])
  @@index([sentAt])
  @@map("telegram_message_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// SALES  (mirrored from the external OTA ticketing system — see
// src/lib/ota/*. OroDashboard doesn't originate this data, it periodically
// pulls and mirrors it so it can be viewed/filtered here instead of the
// source system's own dashboard.)
// ─────────────────────────────────────────────────────────────────────────────

enum SyncSource {
  MANUAL
  AUTO
}

enum SyncStatus {
  SUCCESS
  FAILED
  PARTIAL
  SKIPPED       // no-op: either a walk was already in progress, or the source's
                // own row count hadn't changed since the last full walk
  RATE_LIMITED  // the source's own API throttled us (HTTP 429) — see rateLimitedUntil
}

model SalesTrip {
  // OTA's own trip id — used directly as our primary key so upserts are a
  // natural dedupe, no separate surrogate key needed.
  id                     String   @id
  date                   DateTime
  distanceKm             Decimal  @db.Decimal(10, 2)
  tariff                 Decimal  @db.Decimal(10, 2)
  // The source reports this as a per-passenger rate, not a trip total —
  // totalServiceCharge (serviceCharge x passengers) is the actual amount
  // collected on this trip and is what finance/reporting should sum.
  serviceCharge          Decimal  @db.Decimal(10, 2)
  totalServiceCharge     Decimal  @db.Decimal(12, 2)
  passengers             Int
  level                  String

  companyId              String
  companyName            String

  departureTerminalName  String
  arrivalTerminalName    String

  employeeExternalId     String?
  employeeName           String?
  employeeEmail          String?

  vehicleExternalId      String?
  vehiclePlateNo         String?
  vehiclePlateCode       String?
  vehicleFleetCategory   String?
  vehicleAssociation     String?
  vehicleLevel           String?

  lastSyncId             String?
  lastSync               SalesSyncLog? @relation(fields: [lastSyncId], references: [id])

  firstSeenAt            DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([date])
  @@index([departureTerminalName])
  @@index([arrivalTerminalName])
  @@index([employeeExternalId])
  @@index([vehicleExternalId])
  @@index([lastSyncId])
  @@map("sales_trips")
}

model SalesSyncLog {
  id            String     @id @default(cuid())

  source        SyncSource
  triggeredBy   String?    // AdminUser id when source = MANUAL, null for AUTO

  // Every run walks the source's full, unfiltered table (its own pagination
  // has been observed to skip/duplicate rows across pages while its table
  // is being written to, so date-range filtering isn't trusted here) —
  // these two are informational only, not query params: "where our data
  // stood right before this run started."
  windowFrom    DateTime?
  windowTo      DateTime

  status        SyncStatus @default(SUCCESS)
  passes        Int        @default(0) // how many full-table walks this run needed to converge (or gave up after)
  pagesFetched  Int        @default(0)
  rowsFetched   Int        @default(0)
  rowsCreated   Int        @default(0)
  rowsUpdated   Int        @default(0)
  errorMessage  String?

  // Completeness check: the source's own reported total vs. ours, both
  // read right after this run finished — lets you see at a glance whether
  // we're fully caught up. Null when the run was skipped before either
  // could be measured.
  sourceTotal   Int?
  ourTotal      Int?

  // Set when this run hit HTTP 429 from the source — later runs check this
  // (on the most recent log row) and skip outright until it's passed,
  // instead of immediately re-tripping the same limiter.
  rateLimitedUntil DateTime?

  startedAt     DateTime   @default(now())
  finishedAt    DateTime?

  trips         SalesTrip[]

  @@index([source])
  @@index([startedAt])
  @@map("sales_sync_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// OTA MIRRORS — employees/accounts, terminals, vehicles
// Read-only mirrors of OTA's own data (no write-back). Distinct from the
// locally-managed Employee/Station/Terminal models above, which are
// OroDashboard's own payroll/POS/ops entities. `raw` keeps the complete,
// untouched source payload alongside the flattened columns used for
// filtering/display, so nothing from the source is ever lost.
//
// Employees (company-users) are scoped to this company by the source API.
// Terminals and vehicles are NOT — the source returns its entire nationwide
// tables for both (confirmed live: 728 terminals, ~19.8k vehicles across
// every operator), mirrored here unfiltered by explicit choice.
// ─────────────────────────────────────────────────────────────────────────────

enum OtaSyncEntity {
  EMPLOYEES
  TERMINALS
  VEHICLES
  COMPANY_ROUTES
}

model OtaSyncLog {
  id            String        @id @default(cuid())

  entity        OtaSyncEntity
  source        SyncSource
  triggeredBy   String?       // AdminUser id when source = MANUAL, null for AUTO

  status        SyncStatus    @default(SUCCESS)
  pagesFetched  Int           @default(0)
  rowsFetched   Int           @default(0)
  rowsCreated   Int           @default(0)
  rowsUpdated   Int           @default(0)
  errorMessage  String?

  sourceTotal   Int?
  ourTotal      Int?

  rateLimitedUntil DateTime?

  startedAt     DateTime      @default(now())
  finishedAt    DateTime?

  @@index([entity, startedAt])
  @@map("ota_sync_logs")
}

model OtaEmployee {
  // OTA's own company_user.id, used directly as our primary key.
  id                 String    @id

  companyId          String
  userId              String

  fullName            String
  phone               String?
  email               String?

  position            String?
  department          String?
  employeeIdExternal  String? // OTA's own "employee_id" field — distinct from id above
  joiningDate         DateTime?
  endDate             DateTime?
  isActive            Boolean   @default(true)

  roleName            String?
  roleLabel           String?
  userStatus          String?

  terminalId          String?
  terminalName        String?

  raw                 Json

  firstSeenAt         DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([isActive])
  @@index([companyId])
  @@map("ota_employees")
}

model OtaTerminal {
  // OTA's own terminal id, used directly as our primary key.
  id            String   @id

  name          String
  address       String?
  status        String?

  zoneName      String?
  woredaName    String?
  cityName      String?
  companyNames  String? // comma-joined companies[] operating from this terminal

  raw           Json

  firstSeenAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([name])
  @@map("ota_terminals")
}

model OtaVehicle {
  // OTA's own vehicle id, used directly as our primary key.
  id                    String   @id

  plateNumber           String?
  plateRegion           String?
  seatCapacity          Int?
  status                String?
  isAssignedToRoute     Boolean?
  driverName            String?
  driverLicenceNumber   String?

  fleetTypeName         String?
  associationName       String?
  assignedTerminalId    String?
  assignedTerminalName  String?
  vehicleLevelName      String?

  // The vehicle's current route, if it has one — flattened from the source's
  // vehicleTerminalDestinations (confirmed live: essentially always 0 or 1
  // entries per vehicle, never more).
  departureTerminalName String?
  arrivalTerminalName   String?
  routeDistanceKm       Decimal? @db.Decimal(8, 2)

  raw                   Json

  firstSeenAt           DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([status])
  @@index([assignedTerminalId])
  @@index([plateNumber])
  @@index([associationName])
  @@index([departureTerminalName])
  @@index([arrivalTerminalName])
  @@map("ota_vehicles")
}

// One row per registered route (departure terminal -> destination, with
// distance) among the company's own assigned departure terminals — synced
// from OTA's per-terminal /destinations endpoint, scoped down to just our
// terminals by cross-referencing OtaTerminal.companyNames (already mirrors
// OTA's own per-terminal company roster). Deliberately NOT linked by FK to
// the operational Station/Terminal models — this is OTA's own route-network
// registry, a different concept from our Station (HR/ops) and Terminal
// (deposit-reconciliation) models, which may not have a 1:1 record for
// every OTA-assigned terminal yet.
model OtaCompanyRoute {
  // OTA's own terminal_destination id, used directly as our primary key.
  id                     String   @id

  departureTerminalId    String
  departureTerminalName  String
  arrivalTerminalId      String
  arrivalTerminalName    String

  distanceKm             Decimal  @db.Decimal(8, 2)
  roadType               String?

  raw                    Json

  firstSeenAt            DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([departureTerminalId])
  @@map("ota_company_routes")
}
